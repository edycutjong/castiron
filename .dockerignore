.git
.gitignore
.venv
__pycache__
**/__pycache__
*.pyc
.pytest_cache
.ruff_cache
# runtime state + build artifacts
var
*.db
*.db-wal
*.db-shm
dist
*.egg-info
# not needed at runtime
tests
docs
node_modules
**/node_modules
.DS_Store
