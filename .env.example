# CastIron environment — copy to .env (gitignored) and fill in. NEVER commit .env.
# Absence of credentials is NOT a blocker: with no B2 keys, CastIron runs OFFLINE
# (MockProvider + LocalDirBackend), the always-green demo-day fallback.
#
# Each variable below notes WHERE to get its value. Only B2_* (+ ≥1 TTS key) are
# needed for a real LIVE run; everything else is optional.

# ---- Mode -------------------------------------------------------------------
# Force the offline path even when creds exist (demo-day safety / CI). 1 = on.
OFFLINE=1
# Where the OFFLINE object store lives (LocalDirBackend root). Any writable path.
CASTIRON_LOCAL_STORE=./var/local-store

# ---- Backblaze B2 -----------------------------------------------------------
# Where: https://secure.backblaze.com → B2 Cloud Storage → Application Keys →
#   "Add a New Application Key". Create a bucket-SCOPED key (never the master key).
#   keyID → B2_KEY_ID, applicationKey → B2_APP_KEY (shown ONCE at creation).
#   Shortcut: `scripts/b2_setup.sh --plan` provisions both buckets + a scoped key.
B2_KEY_ID=
B2_APP_KEY=
# Bucket names — create under B2 → Buckets → "Create a Bucket" (or via b2_setup.sh).
# The published bucket must have Object Lock ENABLED at creation (can't add later).
B2_MEDIA_BUCKET=ci-media
B2_PUBLISHED_BUCKET=ci-published
# Where: your bucket's "Endpoint" on the B2 bucket page reads e.g.
#   s3.us-west-004.backblazeb2.com  →  B2_REGION=us-west-004
#   B2_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
B2_REGION=
B2_ENDPOINT_URL=

# ---- Webhooks (B2 Event Notifications -> POST /webhooks/b2) ------------------
# WEBHOOK_URL: the public URL where THIS app receives events (your deployed host).
WEBHOOK_URL=https://api.castiron.edycu.dev/webhooks/b2
# WEBHOOK_HMAC_SECRET: you generate this yourself — `openssl rand -hex 32` —
#   then paste the SAME value into the B2 bucket → Event Notifications → signing
#   secret. CastIron verifies delivery signatures against it (constant-time).
WEBHOOK_HMAC_SECRET=

# ---- Provider API keys (OFFLINE covers all of these; add as budget allows) ---
# TTS ladder — you need at least ONE for a live narration; more = deeper failover.
#   ElevenLabs (rung 0): https://elevenlabs.io → Profile → API Keys
ELEVENLABS_API_KEY=
#   Free plan: pin a PREMADE voice id (library/professional voices return 402).
#   Leave blank to auto-discover a premade voice. Find ids at /v1/voices.
ELEVENLABS_VOICE_ID=
#   LMNT (rung 1): https://app.lmnt.com → Account → API Keys
LMNT_API_KEY=
#   Hume AI (rung 2): https://platform.hume.ai → API Keys
HUME_API_KEY=
# Music / cover art providers:
#   Stability AI: https://platform.stability.ai/account/keys
STABILITY_API_KEY=
#   OpenAI (DALL·E / TTS alt): https://platform.openai.com/api-keys
OPENAI_API_KEY=
#   GMI Cloud (inference alt): https://console.gmicloud.ai → API Keys
GMI_API_KEY=
# P5 (Transcript Gate) — Tier B; not required before P5.
#   AssemblyAI: https://www.assemblyai.com/app → your API key on the dashboard
ASSEMBLYAI_API_KEY=

# ---- Budget guardrails (hard caps) ------------------------------------------
# Self-chosen. A run whose projected cost exceeds this hard-aborts before spending.
MAX_RUN_COST_USD=1.50

# ---- Manifest strictness (genblaze) -----------------------------------------
# Prod hard-fails unverified manifest reads. Leave unset in dev.
# GENBLAZE_STRICT_MANIFEST_READS=1
